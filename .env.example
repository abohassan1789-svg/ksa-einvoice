# Copy this file to ".env" and fill in your own values.
# The Windows installer generates this file for you from the values you enter
# during setup, so you normally only edit it for manual/dev installs.
#
#   copy .env.example .env      (Windows)
#   cp   .env.example .env      (Git Bash / POSIX)

# --- PostgreSQL connection ---------------------------------------------------
DB_NAME=ksa_einvoice
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# --- Application -------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
